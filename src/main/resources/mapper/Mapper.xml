<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.library.mapper.BookMapper">

    <select id="selectAll" resultType="com.library.entity.BookEntity">
        select * from book
    </select>

    <select id="selectById" resultType="com.library.entity.BookEntity">
        select * from book where id = #{id}
    </select>

    <insert id="insert">
        insert into book(book_name, author, price)
        values (#{bookName}, #{author}, #{price})
    </insert>

    <update id="update">
        update book set book_name = #{bookName}, author = #{author}, price = #{price}
        where id = #{id}
    </update>

    <delete id="deleteById">
        delete from book where id = #{id}
    </delete>

</mapper>
